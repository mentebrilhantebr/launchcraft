# ============================================
# LAUNCHCRAFT MVP - EXEMPLO DE VARIÁVEIS
# ============================================
# Copie este arquivo para .env e preencha com valores reais

# --------------------------------------------
# DATABASE - PostgreSQL + PgBouncer
# --------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/launchcraft_dev?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/launchcraft_dev?schema=public"

# --------------------------------------------
# NODE
# --------------------------------------------
NODE_ENV="development"

# --------------------------------------------
# NEXT.JS
# --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------
# JWT (Etapa 3 - Autenticação)
# --------------------------------------------
# JWT_SECRET="your-secret-key-here"
# JWT_REFRESH_SECRET="your-refresh-secret-key-here"

# --------------------------------------------
# LLM APIs (Etapa 4/5 - Orquestração de IA)
# --------------------------------------------
# Provedor ativo: SOMENTE Anthropic (Claude). Decisão da Etapa 5.
ANTHROPIC_API_KEY="sk-ant-..."
LLM_PRIMARY_PROVIDER="anthropic"
# Fallback DESATIVADO por padrão (deixe vazio). Só preencha se quiser reativar
# um segundo provedor (ex: "openai"). O código do OpenAIProvider é mantido.
LLM_FALLBACK_PROVIDER=""
# OpenAI é opcional — só necessário se LLM_FALLBACK_PROVIDER="openai".
# OPENAI_API_KEY="sk-..."
# LLM_MAX_TOKENS="4096"
# LLM_TEMPERATURE="0.7"

# --------------------------------------------
# REDIS (Etapa 4/6 - Fila de tarefas BullMQ)
# --------------------------------------------
# REDIS_URL="redis://localhost:6379"

# --------------------------------------------
# S3 / STORAGE (Etapa 8 - Armazenamento)
# --------------------------------------------
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="launchcraft-files"
# MAX_FILE_SIZE_MB="10"

# --------------------------------------------
# STRIPE (Etapa 10 - Pagamentos)
# --------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --------------------------------------------
# SENTRY (Etapa 11 - Monitoramento)
# --------------------------------------------
# SENTRY_DSN="https://...@sentry.io/..."
